#!/bin/bash

# ─── Resolve project root (absolute path) ────────────────────────────────────
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ─── Color & Style Definitions (safe for non-TTY) ────────────────────────────
RED=$(tput setaf 1 2>/dev/null || true)
GREEN=$(tput setaf 2 2>/dev/null || true)
YELLOW=$(tput setaf 3 2>/dev/null || true)
BLUE=$(tput setaf 4 2>/dev/null || true)
BOLD=$(tput bold 2>/dev/null || true)
RST=$(tput sgr0 2>/dev/null || true)

# Trap Ctrl-C to exit the entire script
trap 'echo -e "\n${RED}❌ Setup interrupted by user. Exiting...${RST}"; exit 1' INT

# ─── Logging Functions ────────────────────────────────────────────────────────
log_info() { echo -e "  ${BLUE}ℹ️  ${RST}$1"; }
log_success() { echo -e "  ${GREEN}✅ ${RST}$1"; }
log_warning() { echo -e "  ${YELLOW}⚠️  ${RST}$1"; }
log_error() { echo -e "  ${RED}❌ ${RST}$1"; }

# ─── Fatal: print error banner and abort ──────────────────────────────────────
die() {
	echo ""
	echo -e "${RED}┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓${RST}"
	echo -e "${RED}┃${RST}  ❌  ${BOLD}SETUP FAILED${RST}"
	echo -e "${RED}┃${RST}     $1"
	echo -e "${RED}┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛${RST}"
	exit 1
}

# ─── Main ─────────────────────────────────────────────────────────────────────
main() {
	echo ""
	echo -e "${GREEN}${BOLD}┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓${RST}"
	echo -e "${GREEN}${BOLD}┃${RST}  🐧  ${BOLD}Linux Environment Setup Script${RST}"
	echo -e "${GREEN}${BOLD}┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛${RST}"

	# Collect forwarding args (only forward recognized flags)
	local FORWARD_ARGS=()
	local DOCKER_MODE=false
	local DOCKER_ARGS=()
	for _a in "$@"; do
		case "$_a" in
			--help | -h)
				echo ""
				echo "Usage: bash setup [OPTIONS]"
				echo ""
				echo "Options:"
				echo "  --neovim                  Only setup Neovim (clangd + tree-sitter)"
				echo "  --skip-neovim             Setup everything except Neovim"
				echo "  --offline=DIR             Use offline packages from DIR (skip GitHub downloads)"
				echo "                            Required packages in DIR:"
				echo "                              Ubuntu: nvim-linux-<arch>.tar.gz, clangd-linux-*.zip,"
				echo "                                      cpptools-linux-<x64|arm64>.vsix,"
				echo "                                      marksman-linux-<x64|arm64>"
				echo "                              Fedora: clangd-linux-*.zip,"
				echo "                                      cpptools-linux-<x64|arm64>.vsix,"
				echo "                                      marksman-linux-<x64|arm64>"
				echo "                            (<arch> = x86_64 or aarch64)"
				echo "  --china                   Use rsproxy.cn mirror for Rust (crates.io + rustup)"
				echo "  --docker                  Build a Docker dev environment instead of local setup"
				echo "  --fedora                  Docker: use Fedora base image (default)"
				echo "  --ubuntu                  Docker: use Ubuntu base image"
				echo "  --help, -h                Show this help message"
				echo ""
				echo "Examples:"
				echo "  bash setup                              # Full local setup"
				echo "  bash setup --neovim                     # Neovim only"
				echo "  bash setup --skip-neovim                # Skip Neovim (faster)"
				echo "  bash setup --offline=/path/to/packages   # Offline mode (local)"
				echo "  bash setup --docker                     # Docker dev env (Fedora)"
				echo "  bash setup --docker --ubuntu            # Docker dev env (Ubuntu)"
				echo "  bash setup --docker --skip-neovim       # Docker, skip Neovim"
				echo "  bash setup --docker --offline=/path/to/packages  # Docker, offline mode"
				echo "  bash setup --china                      # Use rsproxy.cn Rust mirror"
				return 0
				;;
			--docker)
				DOCKER_MODE=true
				;;
			--fedora | --ubuntu)
				DOCKER_ARGS+=("$_a")
				;;
			--github-token=*)
				DOCKER_ARGS+=("$_a")
				;;
			--offline=*)
				FORWARD_ARGS+=("$_a")
				DOCKER_ARGS+=("$_a")
				;;
			--neovim | --skip-neovim)
				FORWARD_ARGS+=("$_a")
				DOCKER_ARGS+=("$_a")
				;;
			--china)
				FORWARD_ARGS+=("$_a")
				DOCKER_ARGS+=("$_a")
				;;
		esac
	done

	# ─── Docker mode: delegate to docker/build.sh ────────────────────────
	if [ "$DOCKER_MODE" = true ]; then
		if [ ! -f "$PROJECT_ROOT/docker/build.sh" ]; then
			die "Docker build script not found: $PROJECT_ROOT/docker/build.sh"
		fi
		bash "$PROJECT_ROOT/docker/build.sh" "${DOCKER_ARGS[@]+"${DOCKER_ARGS[@]}"}"
		return $?
	fi

	local RELEASE_FILE=/etc/os-release
	local DIST=""
	local PRETTY_NAME=""

	if [ -f "$RELEASE_FILE" ]; then
		DIST=$(grep '^NAME=' $RELEASE_FILE | sed -n 's/NAME=//p' | tr -d '"')
		PRETTY_NAME=$(grep '^PRETTY_NAME=' $RELEASE_FILE | sed -n 's/PRETTY_NAME=//p' | tr -d '"')
	else
		die "Cannot find /etc/os-release — this script requires a Linux distribution with systemd."
	fi

	log_success "Detected: ${BOLD}${PRETTY_NAME}${RST}"

	case "$DIST" in
		*Fedora*)
			export DIST_ROOT="$PROJECT_ROOT/dist/Fedora"
			if [ ! -f "$DIST_ROOT/setup.sh" ]; then
				die "Setup script not found: $DIST_ROOT/setup.sh"
			fi
			log_info "Launching Fedora setup..."
			if bash "$DIST_ROOT/setup.sh" "${FORWARD_ARGS[@]}"; then
				log_success "Fedora setup completed successfully"
			else
				die "Fedora setup failed — check the output above for details."
			fi
			;;
		*Ubuntu*)
			export DIST_ROOT="$PROJECT_ROOT/dist/Ubuntu"
			if [ ! -f "$DIST_ROOT/setup.sh" ]; then
				die "Setup script not found: $DIST_ROOT/setup.sh"
			fi
			log_info "Launching Ubuntu setup..."
			if bash "$DIST_ROOT/setup.sh" "${FORWARD_ARGS[@]}"; then
				log_success "Ubuntu setup completed successfully"
			else
				die "Ubuntu setup failed — check the output above for details."
			fi
			;;
		*)
			die "Unrecognized distribution: ${BOLD}${DIST}${RST}\n${RED}┃${RST}     Supported distributions: Fedora, Ubuntu."
			;;
	esac

	echo ""
	echo -e "${GREEN}${BOLD}┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓${RST}"
	echo -e "${GREEN}${BOLD}┃${RST}  🎉  ${BOLD}All done! Setup completed successfully.${RST}"
	echo -e "${GREEN}${BOLD}┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛${RST}"
}

main "$@"
