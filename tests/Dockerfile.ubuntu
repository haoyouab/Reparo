FROM ubuntu:latest

ENV DEBIAN_FRONTEND=noninteractive

# ─── Install sudo and basic tools for tput ────────────────────────────────────
RUN apt-get update \
	&& apt-get install -y sudo ncurses-bin bash \
	&& rm -rf /var/lib/apt/lists/*

# ─── Create test user with passwordless sudo ──────────────────────────────────
RUN useradd -m testuser \
	&& echo 'testuser ALL=(ALL) NOPASSWD:ALL' >>/etc/sudoers

# ─── Copy repo into container ─────────────────────────────────────────────────
COPY --chown=testuser:testuser . /home/testuser/Reparo

# ─── Switch to test user ──────────────────────────────────────────────────────
USER testuser
WORKDIR /home/testuser/Reparo

# Ensure .bashrc exists (powerline appends to it)
RUN touch /home/testuser/.bashrc

# ─── Run setup + verification ─────────────────────────────────────────────────
# Pass SKIP_NEOVIM=true to skip slow neovim step (Rust/cargo compilation)
CMD ["bash", "-c", "\
  args=''; \
  [ \"${SKIP_NEOVIM:-false}\" = 'true' ] && args='--skip-neovim'; \
  bash setup $args && bash tests/verify-setup.sh"]
