neww -n Debug
splitw -h -p 50
splitw -v -p 35
select-pane -t 1
splitw -v -p 75
splitw -v -p 27
select-pane -t 2
splitw -h -p 40
select-pane -t 6

run 'cut -c3- ~/.tmux.conf.debug | sh -s _set_debug_windows'

