FROM ubuntu:latest

ENV DEBIAN_FRONTEND=noninteractive

# ─── Use Tsinghua mirror for faster package downloads ─────────────────────────
RUN sed -i 's@//.*archive.ubuntu.com@//mirrors.tuna.tsinghua.edu.cn@g' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null \
	|| sed -i 's@//.*archive.ubuntu.com@//mirrors.tuna.tsinghua.edu.cn@g' /etc/apt/sources.list 2>/dev/null \
	|| true

# ─── Build arguments for dynamic user ───────────────────────────────────────
ARG USERNAME=dev
ARG USER_UID=1000

# ─── Install sudo and basic tools for tput ────────────────────────────────────
RUN apt-get update \
	&& apt-get install -y sudo ncurses-bin bash \
	&& rm -rf /var/lib/apt/lists/*

# ─── Create user matching host (uid matching for volume mounts) ──────────────
# Ubuntu base image has a built-in 'ubuntu' user at uid 1000; remove it first
# If USER_UID is 0 (root), skip user creation and use root directly
RUN userdel -r ubuntu 2>/dev/null || true \
	&& if [ "${USER_UID}" -eq 0 ]; then \
		echo "Using root user (UID 0)"; \
	else \
		useradd -m -u ${USER_UID} ${USERNAME} \
		&& echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >>/etc/sudoers; \
	fi

# ─── Set effective username for subsequent commands ─────────────────────────
# When USER_UID is 0, use 'root' as the effective username
ENV EFFECTIVE_USERNAME=${USERNAME}
RUN if [ "${USER_UID}" -eq 0 ]; then echo "export EFFECTIVE_USERNAME=root" >> /etc/environment; fi

# ─── Copy repo into container ─────────────────────────────────────────────────
# Use root's home when UID is 0, otherwise use the created user's home
RUN if [ "${USER_UID}" -eq 0 ]; then \
		mkdir -p /root/Reparo; \
	else \
		mkdir -p /home/${USERNAME}/Reparo; \
	fi
COPY . /tmp/Reparo
RUN cp -r /tmp/Reparo/* /root/Reparo/ 2>/dev/null || cp -r /tmp/Reparo/. /root/Reparo/ || true

# ─── Switch to user ─────────────────────────────────────────────────────────
# When running as root (UID 0), stay as root
USER root
WORKDIR /root/Reparo

# Ensure .bashrc exists (powerline appends to it)
RUN touch /root/.bashrc

# ─── Run setup during build (bake configs into image) ────────────────────────
# GITHUB_TOKEN: pass a GitHub personal access token to avoid API rate limits
#   docker build --build-arg GITHUB_TOKEN=ghp_xxx ...
ARG SKIP_NEOVIM=false
ARG GITHUB_TOKEN=
ARG OFFLINE_ARGS=
ENV GITHUB_TOKEN=${GITHUB_TOKEN}
RUN bash -c '\
  args=""; \
  [ "$SKIP_NEOVIM" = "true" ] && args="--skip-neovim"; \
  [ -n "$OFFLINE_ARGS" ] && args="$args $OFFLINE_ARGS"; \
  bash setup $args'
# Clear token from final image (do NOT leak secrets into image layers)
ENV GITHUB_TOKEN=

# ─── Default: interactive shell in home directory ─────────────────────────────
ENV PATH="/root/.local/bin:/root/.cargo/bin:${PATH}"
WORKDIR /root
CMD ["bash"]
